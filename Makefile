CC = gcc
AS = as
LD = ld

INCLUDES = -I. -Isrc/kernel -Isrc/lib -Isrc/mm -Idrivers/core -Idrivers/keyboard -Idrivers/timer -Idrivers/vga
CFLAGS = -m32 -ffreestanding -fno-builtin -nostdlib \
         -fno-pie -fno-stack-protector -Wall -Wextra -g -c -MMD -MP $(INCLUDES)
ASFLAGS = --32 --noexecstack -g
LDFLAGS = -T linker.ld -m elf_i386
OBJCOPY = objcopy

C_SRCS = src/kernel/kernel.c \
         src/kernel/kprintf.c \
         src/kernel/multiboot.c \
         src/kernel/programs.c \
         src/kernel/shell.c \
         src/kernel/syscall.c \
         src/kernel/thread.c \
         src/lib/string.c \
         src/mm/heap.c \
         src/mm/paging.c \
         src/mm/pmm.c \
         drivers/core/gdt.c \
         drivers/core/idt.c \
         drivers/core/isr.c \
         drivers/keyboard/keyboard.c \
         drivers/timer/timer.c \
         drivers/vga/vga.c
ASM_SRCS = src/arch/boot.s \
           src/arch/interrupts.s \
           src/arch/switch.s

# User programs: each is linked at USER_START with the small runtime in user/,
# turned into a flat binary and embedded in the kernel by user/programs.s.
USER_PROGRAMS = hello
USER_CFLAGS = -m32 -ffreestanding -fno-builtin -nostdlib \
              -fno-pie -fno-stack-protector -Wall -Wextra -g -c -MMD -MP -I. -Iuser
USER_LIB = user/crt0.o user/ulib.o
USER_BINS = $(USER_PROGRAMS:%=user/%.bin)
USER_DEPS = user/ulib.d $(USER_PROGRAMS:%=user/%.d)

OBJS = $(ASM_SRCS:.s=.o) $(C_SRCS:.c=.o) user/programs.o
DEPS = $(C_SRCS:.c=.d) $(USER_DEPS)

QEMU = qemu-system-i386

.PHONY: all iso run run-iso debug clean

all: build/kernel.bin

build:
	mkdir -p $@

build/kernel.bin: $(OBJS) | build
	$(LD) $(LDFLAGS) $(OBJS) -o $@

%.o: %.c
	$(CC) $(CFLAGS) $< -o $@

%.o: %.s
	$(AS) $(ASFLAGS) $< -o $@

user/%.o: CFLAGS = $(USER_CFLAGS)

user/%.elf: user/%.o $(USER_LIB) user/user.ld
	$(LD) -T user/user.ld -m elf_i386 $(USER_LIB) $< -o $@

user/%.bin: user/%.elf
	$(OBJCOPY) -O binary $< $@

user/programs.o: $(USER_BINS)

# Keep the intermediate user objects and ELF files instead of rebuilding them every time.
.SECONDARY: $(USER_LIB) $(USER_PROGRAMS:%=user/%.o) $(USER_PROGRAMS:%=user/%.elf)

iso: build/os.iso

build/os.iso: build/kernel.bin iso/boot/grub/grub.cfg
	mkdir -p iso/boot/grub
	cp build/kernel.bin iso/boot/
	grub-mkrescue -o $@ iso

# QEMU loads Multiboot kernels directly, so GRUB is only needed for the ISO.
run: build/kernel.bin
	$(QEMU) -kernel $<

run-iso: build/os.iso
	$(QEMU) -cdrom $<

# Start paused with a GDB server on localhost:1234 (see .vscode/launch.json).
debug: build/kernel.bin
	$(QEMU) -kernel $< -s -S

clean:
	rm -rf $(OBJS) $(DEPS) $(USER_LIB) user/*.o user/*.elf user/*.bin build/*.o build/*.bin build/*.iso

# Header dependencies generated by -MMD, so editing a .h rebuilds its users.
-include $(DEPS)
