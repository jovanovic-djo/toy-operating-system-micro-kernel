{
  "version": "2.0.0",
  "tasks": [
    {
        "label": "Build Kernel",
        "type": "shell",
        "command": "make",
        "group": {
            "kind": "build",
            "isDefault": true
      }
    },
    {
        "label": "Run Kernel",
        "type": "shell",
        "command": "make run"
    },
    {
        "label": "Start QEMU (debug)",
        "type": "shell",
        "command": "make debug",
        "isBackground": true,
        "problemMatcher": {
            "owner": "qemu",
            "pattern": { "regexp": "^__never_matches__$" },
            "background": {
                "activeBegins": true,
                "beginsPattern": "qemu-system",
                "endsPattern": "qemu-system"
            }
        }
    }
  ]
}
